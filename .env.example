# MedScan Assist - Environment Configuration Template
# Copy this file to .env and adjust values as needed.

# Dataset Configuration
DATASET_DIR=data/chest_xray

# Hardware Device (Leave blank for automatic detection: cuda > cpu; or specify 'cuda', 'cpu')
DEVICE=

# Training Hyperparameters
BATCH_SIZE=32
LEARNING_RATE=0.001
EPOCHS=25
EARLY_STOPPING_PATIENCE=5
WEIGHT_DECAY=0.0001
DROPOUT_RATE=0.3
IMAGE_SIZE=224
NUM_WORKERS=0
SEED=42

# Image Validation Limits
MAX_FILE_SIZE_BYTES=10485760

# Image Quality Check Thresholds
MIN_BRIGHTNESS_THRESHOLD=20.0
MAX_BRIGHTNESS_THRESHOLD=235.0
MIN_LAPLACIAN_VAR_THRESHOLD=80.0

# Inference & Abstention Settings
CONFIDENCE_THRESHOLD=0.70
